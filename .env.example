# Den enda nyckeln som krävs. sk_live_ tar riktiga kort. sk_test_ är testläge.
STRIPE_SECRET_KEY=

# Valfri. Utan den skapas priset 29 SEK automatiskt, med lookup key "ikvall".
# Om du sätter den måste priset vara aktivt och exakt 29 SEK.
# STRIPE_PRICE_ID=

# Valfri. Webhooken bekräftar köpet. Länken skapas på sidan efter betalning.
# stripe listen --forward-to localhost:3457/api/webhook
# STRIPE_WEBHOOK_SECRET=

# Valfri lokalt. Utan den sparas en hemlighet i .data/signing-secret.
# Sätt den i produktion, och byt den inte efter att folk har fått länkar.
# SIGNING_SECRET=

# Krävs för sk_live_ om appen inte redan nås via https.
# NEXT_PUBLIC_SITE_URL=https://example.com
